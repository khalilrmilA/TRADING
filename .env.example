# Trading AI Platform — environment template (copy to .env and adjust)
# PAPER TRADING ONLY — no real-money execution, no private exchange keys.

# ----- Ollama (local LLM) ----------------------------------------------------
OLLAMA_URL=http://localhost:11434
# Best model for a 16 GB VRAM GPU (RTX 5060 Ti): qwen3:14b — fits fully in VRAM.
# Supported alternatives (run, but partially offload to CPU on 16 GB cards):
#   qwen3:32b            (higher quality, ~5-10 tok/s)
#   qwen3:30b-a3b        (MoE — near-32b quality at much higher speed; good 2nd choice)
#   deepseek-r1:32b      (deep reasoning, slow)
#   qwen2.5-coder:32b    (code generation)
OLLAMA_MODEL=qwen3:14b
OLLAMA_FALLBACK_MODEL=deepseek-r1:32b
OLLAMA_CODE_MODEL=qwen2.5-coder:32b
OLLAMA_TIMEOUT=180
OLLAMA_RETRIES=3

# ----- Backend API -----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# ----- Storage ---------------------------------------------------------------
# DB_PATH=C:\path\to\trading.db   (default: <project>/data/trading.db)

# ----- Paper account ---------------------------------------------------------
INITIAL_CAPITAL=100000
COMMISSION_RATE=0.001
SLIPPAGE_RATE=0.0005

# ----- Risk management -------------------------------------------------------
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT=0.03
CIRCUIT_BREAKER_DRAWDOWN=0.10
ATR_STOP_MULTIPLIER=2.0
ATR_TAKE_PROFIT_MULTIPLIER=3.0

# ----- Data updates ----------------------------------------------------------
DATA_UPDATE_INTERVAL_MINUTES=15
